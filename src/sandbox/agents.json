{
  "opencode": {
    "label": "OpenCode",
    "command": "opencode",
    "args": [],
    "install": "curl -fsSL https://opencode.ai/install | bash && mv /root/.opencode /opt/opencode && chmod -R a+rX /opt/opencode && ln -sf /opt/opencode/bin/opencode /usr/local/bin/opencode",
    "auth_files": [],
    "config_dirs": ["/workspace/.config/opencode"],
    "env_vars": ["OPENCODE_API_KEY", "OPENROUTER_API_KEY"],
    "instruction_file": "AGENTS.md",
    "plugins": ["oh-my-openagent"]
  },
  "claude": {
    "label": "Claude Code",
    "command": "claude",
    "args": [],
    "install": "curl -fsSL https://claude.ai/install.sh | bash",
    "auth_files": ["~/.claude/auth.json"],
    "config_dirs": ["/root/.claude"],
    "env_vars": ["ANTHROPIC_API_KEY"],
    "instruction_file": "CLAUDE.md",
    "plugins": []
  },
  "cursor": {
    "label": "Cursor CLI",
    "command": "agent",
    "args": [],
    "install": "curl https://cursor.com/install -fsS | bash",
    "auth_files": ["~/.cursor/config.json"],
    "config_dirs": ["/root/.cursor"],
    "env_vars": ["CURSOR_API_KEY"],
    "instruction_file": ".cursorrules",
    "plugins": []
  },
  "copilot": {
    "label": "GitHub Copilot",
    "command": "gh copilot",
    "args": ["agent"],
    "install": "npm install -g @github/copilot",
    "auth_files": ["~/.copilot/config.json"],
    "config_dirs": ["/root/.copilot"],
    "env_vars": ["GITHUB_COPILOT_API_KEY"],
    "instruction_file": null,
    "plugins": []
  }
}
